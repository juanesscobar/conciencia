# ============================================================
# MISSION CONTROL — .env para docker compose (producción)
# Copiar a .env en la raíz del repo (junto a docker-compose.yml)
# Generar secretos:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# --- Base de datos (Postgres) ---
POSTGRES_PASSWORD=cambia-este-valor

# --- Redis ---
REDIS_PASSWORD=cambia-este-valor

# --- Seguridad ---
SECRET_KEY=genera-uno-fuerte-con-token_urlsafe

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_USERNAME=juanesscobar

# --- Agentes LLM (DeepSeek) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- CORS / Frontend ---
# Dominio público de Mission Control (HTTPS). Vacío = API relativa.
# Para Tailscale: CORS_ORIGINS=http://mission-control
# Para Let's Encrypt público: CORS_ORIGINS=https://mc.46.62.196.151.sslip.io
CORS_ORIGINS=http://mission-control
VITE_API_URL=
