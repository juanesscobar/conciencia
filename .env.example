# ============================================================
# MISSION CONTROL — .env para docker compose (producción)
# Copiar a .env en la raíz del repo (junto a docker-compose.yml)
# Generar secretos:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# --- Base de datos (Postgres) ---
POSTGRES_PASSWORD=cambia-este-valor

# --- Redis ---
REDIS_PASSWORD=cambia-este-valor

# --- Seguridad ---
SECRET_KEY=genera-uno-fuerte-con-token_urlsafe

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_USERNAME=juanesscobar

# --- Agentes LLM (DeepSeek) ---
DEEPSEEK_API_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- CORS / Frontend ---
# Dominio público de Mission Control (HTTPS). Vacío = API relativa.
CORS_ORIGINS=https://mc.46.62.196.151.sslip.io
VITE_API_URL=
